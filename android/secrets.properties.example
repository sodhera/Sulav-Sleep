# Copy to android/secrets.properties (gitignored) and fill in real values.
# Same Supabase project as the iOS app (ios/Config.xcconfig). Without this
# file the app builds and runs in dev mode: auth shows a friendly error and
# nothing gates.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# RevenueCat Android (Google Play) public SDK key. Empty = dev mode: the
# entitlement resolves "entitled" and the paywall never shows.
REVENUECAT_API_KEY=
# Google OAuth *web* client id (the one Supabase's Google provider is
# configured with). Empty = the Google sign-in buttons don't render.
GOOGLE_WEB_CLIENT_ID=
