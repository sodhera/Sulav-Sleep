<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: deep navy behind the icon, never white. -->
    <style name="Theme.SleepBlock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#08111E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#08111E</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#08111E</item>
    </style>
</resources>
