// Committed. Declares empty defaults so the project builds without any local
// setup, then pulls in the gitignored Config.xcconfig (if a developer has
// created one from Config.xcconfig.example) to override with real values.
// See docs/auth-setup.md.
SUPABASE_URL =
SUPABASE_ANON_KEY =
REVENUECAT_API_KEY =
// TikTok ad attribution (SleepTikTok.swift). Empty on any build that has no
// Config.xcconfig, which disables event reporting entirely — see
// docs/development.md. APPLE_APP_ID is the numeric App Store id, TIKTOK_APP_ID
// is the app's id in TikTok Events Manager, and the access token authorizes
// reporting. Unlike the Supabase anon and RevenueCat public keys, the TikTok
// access token is NOT client-safe by design; it ships in the binary because
// the SDK requires it, so treat it as rotatable, not secret.
APPLE_APP_ID =
TIKTOK_APP_ID =
TIKTOK_ACCESS_TOKEN =

#include? "Config.xcconfig"
