<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24093.7" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="SPLASH-VC">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24053.1"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--The splash sloth (SplashSloth.imageset, generated by scripts/generate-app-icon.py):
            the icon's sloth-on-pillow art on a transparent background, sitting flush on
            SleepColor.background (#08111E) — no rounded icon rectangle. Size and position
            must match LaunchSplashView (RootView.swift), which takes over this exact frame
            and animates the rising z's; a launch storyboard itself is a static snapshot.-->
        <scene sceneID="SPLASH-SCENE">
            <objects>
                <viewController storyboardIdentifier="SplashScreenViewController" id="SPLASH-VC" sceneMemberID="viewController">
                    <view key="view" userInteractionEnabled="NO" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" id="SPLASH-CONTAINER" userLabel="ContainerView">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashSloth" translatesAutoresizingMaskIntoConstraints="NO" id="SPLASH-ICON" userLabel="SplashSloth">
                                <rect key="frame" x="96.5" y="366" width="200" height="120"/>
                                <accessibility key="accessibilityConfiguration">
                                    <accessibilityTraits key="traits" image="YES" notEnabled="YES"/>
                                </accessibility>
                                <constraints>
                                    <constraint firstAttribute="width" constant="200" id="SPLASH-ICON-W"/>
                                    <constraint firstAttribute="height" constant="120" id="SPLASH-ICON-H"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="SPLASH-SAFEAREA"/>
                        <constraints>
                            <constraint firstItem="SPLASH-ICON" firstAttribute="centerY" secondItem="SPLASH-CONTAINER" secondAttribute="centerY" id="SPLASH-CENTER-Y"/>
                            <constraint firstItem="SPLASH-ICON" firstAttribute="centerX" secondItem="SPLASH-CONTAINER" secondAttribute="centerX" id="SPLASH-CENTER-X"/>
                        </constraints>
                        <color key="backgroundColor" red="0.031372549" green="0.066666667" blue="0.117647059" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="SPLASH-FIRSTRESPONDER" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="SplashSloth" width="1200" height="720"/>
    </resources>
</document>
