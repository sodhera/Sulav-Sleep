<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<!-- Everything below exists because of the TikTok Business SDK
	     (SleepTikTok.swift). Before it, this array was empty and honestly so:
	     sleep data is local-first and the account lives in the user's own
	     Supabase row. Ad measurement is the first thing this app sends
	     anywhere for a reason that isn't running the app for the user, so it
	     gets declared. Keep this file, the App Store Connect privacy answers,
	     and the published privacy policy saying the same thing — a reviewer
	     compares them, and so does anyone who reads all three. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- The SDK's payload carries IDFV and its own anonymous id
			     (never IDFA: no ATT prompt means the request omits it). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
		</dict>
		<dict>
			<!-- Registration and StartTrial. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
		</dict>
		<dict>
			<!-- Subscribe, which carries the plan's price and currency. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
		</dict>
	</array>
	<!-- False, and it has to stay true-to-life: the app never calls
	     TikTokBusiness.identify (no hashed email or phone leaves the device),
	     never requests ATT, and therefore never gets the IDFA. Sending any of
	     that would make this declaration false and the build rejectable. -->
	<key>NSPrivacyTracking</key>
	<false/>
</dict>
</plist>
